#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require

layout(local_size_x = 1024) in;

layout(std430, binding = 0) readonly buffer W { float w[]; };
layout(std430, binding = 1) buffer A { float a[]; };
layout(std430, binding = 2) readonly buffer C { uint ctl[]; };

layout(push_constant) uniform Push {
    uint x_off;
    uint w_off;
    uint y_off;
    uint n;
    float eps;
    uint stride;
} p;

shared float partial[16];

void main() {
    uint tok = gl_WorkGroupID.y;
    if (tok >= ctl[2]) {
        return;
    }
    uint x = p.x_off + tok * p.stride;
    uint y = p.y_off + tok * p.stride;
    uint t = gl_LocalInvocationID.x;

    float ss = 0.0;
    for (uint i = t; i < p.n; i += 1024) {
        float v = a[x + i];
        ss += v * v;
    }
    ss = subgroupAdd(ss);
    if (gl_SubgroupInvocationID == 0) {
        partial[gl_SubgroupID] = ss;
    }
    memoryBarrierShared();
    barrier();

    float total = 0.0;
    for (uint i = 0; i < 16; i++) {
        total += partial[i];
    }
    float r = inversesqrt(total / float(p.n) + p.eps);
    for (uint i = t; i < p.n; i += 1024) {
        a[y + i] = a[x + i] * r * w[p.w_off + i];
    }
}
