#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Wq { uint wq[]; };
layout(std430, binding = 1) readonly buffer Wd { float16_t wd[]; };
layout(std430, binding = 2) buffer A { float a[]; };
layout(std430, binding = 3) readonly buffer C { uint ctl[]; };

layout(push_constant) uniform Push {
    uint q_off;
    uint d_off;
    uint y_off;
    uint n;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) {
        return;
    }
    uint e = ctl[0] * p.n + i;
    uint w = wq[p.q_off + e / 4];
    int q = int(w << (24 - 8 * (e % 4))) >> 24;
    a[p.y_off + i] = float(wd[p.d_off + e / 32]) * float(q);
}
