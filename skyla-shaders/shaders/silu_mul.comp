#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer A { float a[]; };
layout(std430, binding = 1) readonly buffer C { uint ctl[]; };

layout(push_constant) uniform Push {
    uint g_off;
    uint u_off;
    uint n;
    uint stride;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint tok = gl_WorkGroupID.y;
    if (i >= p.n || tok >= ctl[2]) {
        return;
    }
    uint g = p.g_off + tok * p.stride + i;
    float x = a[g];
    a[g] = x / (1.0 + exp(-x)) * a[p.u_off + tok * p.stride + i];
}
