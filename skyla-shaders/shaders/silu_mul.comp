#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer A { float a[]; };

layout(push_constant) uniform Push {
    uint g_off;
    uint u_off;
    uint n;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) {
        return;
    }
    float g = a[p.g_off + i];
    a[p.g_off + i] = g / (1.0 + exp(-g)) * a[p.u_off + i];
}
