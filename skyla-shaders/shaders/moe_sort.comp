#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer A { uint a[]; };

layout(push_constant) uniform Push {
    uint ids_off;
    uint table_off;
    uint list_off;
    uint n_expert;
    uint n_used;
} p;

const uint MAX_SLOTS = 1024;

shared uint count[256];
shared uint start[256];
shared uint sid[MAX_SLOTS];

void main() {
    uint t = gl_LocalInvocationID.x;
    uint n = min(a[2] * p.n_used, MAX_SLOTS);
    count[t] = 0;
    memoryBarrierShared();
    barrier();

    for (uint i = t; i < n; i += 256) {
        uint e = a[p.ids_off + i];
        sid[i] = e;
        atomicAdd(count[e], 1);
    }
    memoryBarrierShared();
    barrier();

    if (t == 0) {
        uint s = 0;
        for (uint e = 0; e < p.n_expert; e++) {
            start[e] = s;
            a[p.table_off + 2 * e] = count[e];
            a[p.table_off + 2 * e + 1] = s;
            s += count[e];
        }
    }
    memoryBarrierShared();
    barrier();

    for (uint i = t; i < n; i += 256) {
        uint e = sid[i];
        uint rank = 0;
        for (uint j = 0; j < i; j++) {
            rank += uint(sid[j] == e);
        }
        a[p.list_off + start[e] + rank] = i;
    }
}
