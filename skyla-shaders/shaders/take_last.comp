#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer A { float a[]; };
layout(std430, binding = 1) readonly buffer C { uint ctl[]; };

layout(push_constant) uniform Push {
    uint src_off;
    uint dst_off;
    uint n;
    uint stride;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < p.n) {
        a[p.dst_off + i] = a[p.src_off + (ctl[2] - 1) * p.stride + i];
    }
}
