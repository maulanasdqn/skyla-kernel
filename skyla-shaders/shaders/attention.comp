#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

layout(local_size_x = 64) in;
layout(constant_id = 0) const uint N_REP = 2;
layout(constant_id = 1) const uint CHUNK = 64;
layout(constant_id = 2) const bool K_Q8 = false;
layout(constant_id = 3) const bool V_Q8 = false;

layout(std430, binding = 0) buffer A { float a[]; };
layout(std430, binding = 1) readonly buffer C { uint ctl[]; };
layout(std430, binding = 2) readonly buffer KV { f16vec2 kv[]; };
layout(std430, binding = 3) readonly buffer KV8 { int8_t kv8[]; };
layout(std430, binding = 4) readonly buffer KVS { float16_t kvs[]; };

layout(push_constant) uniform Push {
    uint q_off;
    uint part_off;
    uint kc_off;
    uint vc_off;
    uint n_kv;
    uint n_split;
    float scale;
    uint q_stride;
    uint part_stride;
    uint ks_off;
    uint vs_off;
} p;

vec2 load(bool q8, uint cache, uint scales, uint i, uint kvh, uint lane) {
    uint row = p.n_kv * 64;
    if (!q8) {
        return vec2(kv[cache / 2 + i * row + kvh * 64 + lane]);
    }
    float s = float(kvs[scales + i * (p.n_kv * 4) + kvh * 4 + lane / 16]);
    uint b = cache + (i * row + kvh * 64 + lane) * 2;
    return vec2(float(kv8[b]), float(kv8[b + 1])) * s;
}

void main() {
    uint kvh = gl_WorkGroupID.x;
    uint split = gl_WorkGroupID.y;
    uint tok = gl_WorkGroupID.z;
    uint n_pos = ctl[1] + tok + 1;
    if (tok >= ctl[2] || split * CHUNK >= n_pos) {
        return;
    }
    uint lane = gl_LocalInvocationID.x;
    uint q_base = p.q_off + tok * p.q_stride;
    uint part_base = p.part_off + tok * p.part_stride;

    vec2 q[N_REP];
    float m[N_REP];
    float l[N_REP];
    vec2 acc[N_REP];
    for (uint j = 0; j < N_REP; j++) {
        uint qb = q_base + (kvh * N_REP + j) * 128 + lane * 2;
        q[j] = vec2(a[qb], a[qb + 1]) * p.scale;
        m[j] = -1e30;
        l[j] = 0.0;
        acc[j] = vec2(0.0);
    }

    uint end = min(split * CHUNK + CHUNK, n_pos);
    for (uint i = split * CHUNK; i < end; i++) {
        vec2 k = load(K_Q8, p.kc_off, p.ks_off, i, kvh, lane);
        vec2 v = load(V_Q8, p.vc_off, p.vs_off, i, kvh, lane);
        for (uint j = 0; j < N_REP; j++) {
            float s = subgroupAdd(dot(q[j], k));
            float mn = max(m[j], s);
            float c = exp(m[j] - mn);
            float e = exp(s - mn);
            l[j] = l[j] * c + e;
            acc[j] = acc[j] * c + e * v;
            m[j] = mn;
        }
    }

    for (uint j = 0; j < N_REP; j++) {
        uint base = part_base + ((kvh * N_REP + j) * p.n_split + split) * 130;
        if (lane == 0) {
            a[base] = m[j];
            a[base + 1] = l[j];
        }
        a[base + 2 + lane * 2] = acc[j].x;
        a[base + 3 + lane * 2] = acc[j].y;
    }
}
