#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer A { float a[]; };

layout(push_constant) uniform Push {
    uint x_off;
    uint y_off;
    uint weights_off;
    uint n;
    uint stride;
    uint n_used;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) {
        return;
    }
    float sum = 0.0;
    for (uint s = 0; s < p.n_used; s++) {
        sum += a[p.weights_off + s] * a[p.y_off + s * p.stride + i];
    }
    a[p.x_off + i] += sum;
}
